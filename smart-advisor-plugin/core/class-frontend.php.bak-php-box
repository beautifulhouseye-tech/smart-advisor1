    }

    private static function get_safe_color( $color ) {
        $color = sanitize_hex_color( $color );
        return $color ? $color : '#e91e63';
    }

    private static function get_safe_url( $url ) {
        if ( ! is_string( $url ) || '' === trim( $url ) ) {
            return '';
        }
        return esc_url( $url, array( 'http', 'https' ) );
    }

    public static function render_wishlist_shortcode() {
        ob_start();
        ?>
        <div class="sa-wishlist-page" dir="rtl" style="max-width:1100px;margin:20px auto;padding:12px">
            <h2 style="margin:0 0 16px">♡ قائمة رغباتي</h2>
            <div class="sa-wishlist-items" aria-live="polite">
                <p>جارٍ تحميل قائمة رغباتك...</p>
            </div>
        </div>
        <style>
        .sa-wishlist-page { box-sizing: border-box; width: 100%; }
        .sa-wishlist-page * { box-sizing: border-box; }
        .sa-wishlist-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; }
        .sa-wishlist-card { border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden; background: #fff; color: #222; }
        .sa-wishlist-card img { width: 100%; height: 160px; object-fit: contain; background: #f7f7f7; display: block; }
        .sa-wishlist-card-body { padding: 10px; }
        .sa-wishlist-card a { color: inherit; text-decoration: none; }
        .sa-wishlist-remove { display: block; width: calc(100% - 20px); margin: 9px 10px 10px; padding: 9px; border: 0; border-radius: 8px; background: #fce7eb; color: #b4234d; font-weight: 700; cursor: pointer; }
        .sa-wishlist-remove:focus-visible { outline: 2px solid #b4234d; outline-offset: 3px; }
        @media(max-width:480px) { .sa-wishlist-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
        </style>
        <script>
        (function(){
            'use strict';
            var scripts = document.querySelectorAll('.sa-wishlist-page');
            var root = scripts[scripts.length - 1];
            if (!root || root.dataset.saWishlistReady === '1') return;
            root.dataset.saWishlistReady = '1';

            var target = root.querySelector('.sa-wishlist-items');
            if (!target) return;

            var MAX_ITEMS = 100;

            function read() {
                try {
                    var value = JSON.parse(localStorage.getItem('sa_wishlist') || '[]');
                    if (!Array.isArray(value)) return [];
                    return value.filter(function(item) {
                        return (item && item.id && typeof item.id === 'string') || (item && item.id && typeof item.id === 'number');
                    }).slice(0, MAX_ITEMS);
                } catch(e) { return []; }
            }

            function write(value) {
                try {
                    var unique = [];
                    value.forEach(function(item) {
                        if (!item || !item.id) return;
                        var exists = unique.some(function(x) { return String(x.id) === String(item.id); });
                        if (!exists) unique.push(item);
                    });
                    localStorage.setItem('sa_wishlist', JSON.stringify(unique.slice(0, MAX_ITEMS)));
                } catch(e) {}
            }

            function safeURL(value) {
                try {
                    var url = new URL(String(value || ''), window.location.origin);
                    if (url.protocol !== 'http:' && url.protocol !== 'https:') return '';
                    return url.href;
                } catch(e) { return ''; }
            }

            function draw() {
                var list = read();
                target.textContent = '';
                if (!list.length) {
                    var empty = document.createElement('p');
                    empty.textContent = 'قائمة رغباتك فارغة. أضف المنتجات من المستشار الذكي.';
                    target.appendChild(empty);
                    return;
                }
                var grid = document.createElement('div');
                grid.className = 'sa-wishlist-grid';
                list.forEach(function(item) {
                    if (!item || !item.id) return;
                    var productURL = safeURL(item.url);
                    if (!productURL) return;

                    var card = document.createElement('article');
                    card.className = 'sa-wishlist-card';
                    var link = document.createElement('a');
                    link.href = productURL;

                    var imageURL = safeURL(item.image);
                    if (imageURL) {
                        var img = document.createElement('img');
                        img.loading = 'lazy';
                        img.alt = String(item.name || 'منتج');
                        img.src = imageURL;
                        link.appendChild(img);
                    }
                    var body = document.createElement('div');
                    body.className = 'sa-wishlist-card-body';
                    var name = document.createElement('strong');
                    name.textContent = String(item.name || 'منتج');
                    body.appendChild(name);
                    if (item.price) {
                        var price = document.createElement('p');
                        price.textContent = String(item.price);
                        body.appendChild(price);
                    }
                    link.appendChild(body);
                    card.appendChild(link);

                    var remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'sa-wishlist-remove';
                    remove.textContent = 'إزالة من رغباتي';
                    remove.addEventListener('click', function() {
                        write(read().filter(function(x) { return String(x.id) !== String(item.id); }));
                        draw();
                    });
                    card.appendChild(remove);
                    grid.appendChild(card);
                });
                if (grid.children.length) {
                    target.appendChild(grid);
                } else {
                    var empty = document.createElement('p');
                    empty.textContent = 'لا توجد منتجات صالحة للعرض.';
                    target.appendChild(empty);
                }
            }

            window.addEventListener('storage', function(e) {
                if (e.key === 'sa_wishlist' || e.key === null) draw();
            });
            window.addEventListener('sa:wishlist-updated', draw);
            draw();
        })();
        </script>
        <?php
        return ob_get_clean();
    }

    public static function maybe_render_wishlist_page( $content ) {
        if ( is_admin() || ! is_page( 'wishlist' ) || ! in_the_loop() || ! is_main_query() ) {
            return $content;
        }
        if ( strpos( $content, '[sa_wishlist]' ) !== false ) {
            return do_shortcode( $content );
        }
        return $content . self::render_wishlist_shortcode();
    }

    public static function render() {
        if ( ! class_exists( 'SA_Settings' ) || ! SA_Settings::should_display() ) return;

        $position = SA_Settings::get( 'position', 'bottom-right' );
        if ( ! in_array( $position, array( 'bottom-left', 'bottom-right' ), true ) ) {
            $position = 'bottom-right';
        }
        $symbol = SA_Settings::get( 'icon_symbol', '💬' );
        $pos_class = 'bottom-left' === $position ? 'sa-pos-left' : 'sa-pos-right';
        ?>
<button id="sa-toggle" class="<?php echo esc_attr( $pos_class ); ?>" type="button" aria-label="<?php echo esc_attr( 'فتح ' . ( class_exists( 'SA_Customer_Service_Settings' ) ? SA_Customer_Service_Settings::get_config()['assistant_name'] : 'المستشار الذكي' ) ); ?>" aria-controls="sa-panel" aria-expanded="false">
    <?php echo esc_html( $symbol ); ?>
</button>

<div id="sa-panel" role="dialog" aria-label="<?php echo esc_attr( class_exists( 'SA_Customer_Service_Settings' ) ? SA_Customer_Service_Settings::get_config()['assistant_name'] : 'المستشار الذكي' ); ?>" aria-hidden="true">
    <div id="sa-head">
        <span><?php echo esc_html( class_exists( 'SA_Customer_Service_Settings' ) ? SA_Customer_Service_Settings::get_config()['assistant_name'] : 'المستشار الذكي' ); ?></span>
        <button id="sa-close" type="button" aria-label="إغلاق المستشار">×</button>
    </div>
    <div id="sa-msgs" aria-live="polite" aria-relevant="additions"></div>
    <?php if ( is_user_logged_in() ) : ?><label class="sa-project-chat-label" style="display:block;padding:6px 12px;font-size:12px">المشروع المرتبط بالمحادثة <select id="sa-chat-project" style="width:100%;padding:7px;border:1px solid #ddd;border-radius:7px"><option value="">محادثة عامة — دون ربط مشروع</option></select></label><?php endif; ?>
    <p class="sa-privacy-note">الرسائل تُرسل إلى مزود ذكاء اصطناعي خارجي لتوليد الردود. لا تشارك بيانات شخصية حساسة.</p>
    <form id="sa-form">
        <input type="text" id="sa-input" placeholder="اكتب سؤالك..." autocomplete="off" maxlength="500" aria-label="اكتب سؤالك">
        <button type="submit" id="sa-send">إرسال</button>
    </form>
</div>
        <?php
    }




    public static function render_wa_box_styles() {
        if ( ! function_exists( 'is_account_page' ) || ! is_account_page() || is_user_logged_in() ) return;
        ?>
        <style>
        /* Hide any duplicate boxes */
        #sa-wa-login-box ~ #sa-wa-login-box,
        #sa-wa-login-box ~ div #sa-wa-login-box { display: none !important; }
        #sa-wa-login-box { max-width:480px; margin:20px auto; padding:20px; border:2px solid #25D366; border-radius:10px; background:#f0fff4; text-align:center; box-sizing:border-box; }
        #sa-wa-login-box h3 { margin:0 0 10px; color:#075E54; font-size:18px; font-weight:bold; }
        #sa-wa-login-box p { margin:0 0 15px; font-size:14px; color:#444; }
        #sa-wa-login-box input.sa-phone { width:100%; padding:12px; margin-bottom:15px; border:1px solid #ccc; border-radius:8px; font-size:16px; text-align:center; box-sizing:border-box; }
        #sa-wa-login-box button { display:block; width:100%; padding:12px; background:#25D366; color:#fff; text-decoration:none; border-radius:8px; font-weight:bold; font-size:15px; border:none; cursor:pointer; box-sizing:border-box; transition:background 0.3s; }
        #sa-wa-login-box button:hover { background:#1da851; }
        /* إخفاء الزر الأسود الفارغ المكسور من Social Login */
        .woocommerce-form-login button[type="submit"]:empty,
        .woocommerce-form-register button[type="submit"]:empty,
        .woocommerce-form-login .social-login-empty-btn,
        .woocommerce-form-register .social-login-empty-btn {
            display: none !important;
        }
        </style>
        <?php
    }

    private static function render_wa_box( $title ) {
        if ( is_user_logged_in() ) return;
        $wa_number = '';
        if ( class_exists( 'SA_WhatsApp_Settings' ) ) {
            $cfg = SA_WhatsApp_Settings::get_config();
            $wa_number = $cfg['whatsapp_number'] ?? '';
        }
        if ( empty( $wa_number ) ) $wa_number = get_option( 'sa_whatsapp_business_number', '' );
        if ( empty( $wa_number ) ) return;
        $wa_number = preg_replace( '/[^0-9]/', '', $wa_number );
        ?>
        <div id="sa-wa-login-box">
            <h3>📱 <?php echo esc_html( $title ); ?></h3>
            <p>أدخل رقم جوالك المسجل في المتجر، وسنرسل لك رابط دخول سري عبر واتساب.</p>
            <form onsubmit="event.preventDefault(); var p=this.querySelector('.sa-phone').value.replace(/[^0-9]/g,''); if(p.length<9||p.length>15){alert('يرجى إدخال رقم صحيح');return;} window.open('https://wa.me/<?php echo esc_js( $wa_number ); ?>?text='+encodeURIComponent('اربط حسابي '+p), '_blank');">
                <input type="tel" class="sa-phone" placeholder="مثال: 777123456" dir="ltr" />
                <button type="submit">📲 إرسال رابط الدخول عبر واتساب</button>
            </form>
        </div>
        <?php
    }

    public static function render_wa_box_register() {
        if ( self::$rendered_wa_register ) return;
        self::$rendered_wa_register = true;
        self::render_wa_box( 'أو سجل عبر واتساب' );
    }

    public static function render_wa_box_login() {
        if ( self::$rendered_wa_login ) return;
        self::$rendered_wa_login = true;
        self::render_wa_box( 'أو سجل الدخول عبر واتساب' );
    }

    public static function inject_wa_box_once() {
        if ( ! function_exists( 'is_account_page' ) || ! is_account_page() || is_user_logged_in() ) return;
        $wa_number = '';
        if ( class_exists( 'SA_WhatsApp_Settings' ) ) {
            $cfg = SA_WhatsApp_Settings::get_config();
            $wa_number = $cfg['whatsapp_number'] ?? '';
        }
        if ( empty( $wa_number ) ) $wa_number = get_option( 'sa_whatsapp_business_number', '' );
        if ( empty( $wa_number ) ) return;
        $wa_number = preg_replace( '/[^0-9]/', '', $wa_number );
        ?>
        <style>
        #sa-wa-login-box { max-width:480px; margin:20px auto; padding:20px; border:2px solid #25D366; border-radius:10px; background:#f0fff4; text-align:center; box-sizing:border-box; }
        #sa-wa-login-box h3 { margin:0 0 10px; color:#075E54; font-size:18px; font-weight:bold; }
        #sa-wa-login-box p { margin:0 0 15px; font-size:14px; color:#444; }
        #sa-wa-login-box input.sa-phone { width:100%; padding:12px; margin-bottom:15px; border:1px solid #ccc; border-radius:8px; font-size:16px; text-align:center; box-sizing:border-box; }
        #sa-wa-login-box button { display:block; width:100%; padding:12px; background:#25D366; color:#fff; text-decoration:none; border-radius:8px; font-weight:bold; font-size:15px; border:none; cursor:pointer; box-sizing:border-box; transition:background 0.3s; }
        #sa-wa-login-box button:hover { background:#1da851; }
        .woocommerce-form-login button[type="submit"]:empty,
        .woocommerce-form-register button[type="submit"]:empty { display: none !important; }
        /* Strong override for WhatsApp button */
        #sa-wa-login-box button,
        #sa-wa-login-box button[type="submit"] {
            background-color: #25D366 !important;
            color: #ffffff !important;
            border: none !important;
            padding: 12px !important;
            border-radius: 8px !important;
            font-weight: bold !important;
            font-size: 15px !important;
            width: 100% !important;
            display: block !important;
            cursor: pointer !important;
            text-decoration: none !important;
            line-height: 1.4 !important;
        }
        #sa-wa-login-box button:hover,
        #sa-wa-login-box button[type="submit"]:hover {
            background-color: #1da851 !important;
        }
        #sa-wa-login-box input.sa-phone {
            border: 1px solid #ccc !important;
            background: #fff !important;
            color: #333 !important;
            display: block !important;
        }
        </style>
        <script>
        (function() {
            function inject() {
                if (document.getElementById('sa-wa-login-box')) return;
                var forms = document.querySelectorAll('.woocommerce-form-login, .woocommerce-form-register');
                if (!forms.length) return;
                var lastForm = forms[forms.length - 1];
                var hasLogin = !!document.querySelector('.woocommerce-form-login');
                var hasReg = !!document.querySelector('.woocommerce-form-register');
                var title = (hasLogin && hasReg) ? '📱 أو سجل / ادخل عبر واتساب' : (hasReg ? '📱 أو سجل عبر واتساب' : '📱 أو سجل الدخول عبر واتساب');
                var box = document.createElement('div');
                box.id = 'sa-wa-login-box';
                box.innerHTML = '<h3>' + title + '</h3>' +
                    '<p>أدخل رقم جوالك المسجل في المتجر، وسنرسل لك رابط دخول سري عبر واتساب.</p>' +
                    '<form><input type="tel" class="sa-phone" placeholder="مثال: 777123456" dir="ltr" /><button type="submit">📲 إرسال رابط الدخول عبر واتساب</button></form>';
                lastForm.parentNode.insertBefore(box, lastForm.nextSibling);
                box.querySelector('form').addEventListener('submit', function(e) {
                    e.preventDefault();
                    var phone = this.querySelector('.sa-phone').value.replace(/[^0-9]/g, '');
                    if (phone.length < 9 || phone.length > 15) { alert('رقم غير صحيح.'); return; }
                    window.open('https://wa.me/<?php echo esc_js( $wa_number ); ?>?text=' + encodeURIComponent('اربط حسابي ' + phone), '_blank');
                });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', inject);
            else inject();
        })();
        </script>
        <?php
    }
}
