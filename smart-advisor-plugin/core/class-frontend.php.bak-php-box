                <div class="sa-profile-actions">
                    <button type="button" class="sa-profile-btn" data-consent="grant">أوافق على حفظ تفضيلاتي</button>
                    <button type="button" class="sa-profile-btn danger" data-consent="revoke">سحب الموافقة وحذف بياناتي</button>
