                            <div class="sa-profile-field"><label>نوع المشروع</label><select name="project_type" required><option value="">اختر نوع المشروع</option><?php $shown_types = []; foreach ( (array) ( $config['projectTypes'] ?? [] ) as $project_type ) : $shown_types[] = $project_type['key']; ?><option value="<?php echo esc_attr( $project_type['key'] ); ?>"><?php echo esc_html( $project_type['name'] ); ?></option><?php endforeach; ?><?php foreach ( [ 'construction'=>'بناء', 'renovation'=>'ترميم', 'gift'=>'هدية', 'electronics'=>'أجهزة إلكترونية', 'other'=>'أخرى' ] as $legacy_key => $legacy_name ) : if ( in_array( $legacy_key, $shown_types, true ) ) continue; ?><option value="<?php echo esc_attr( $legacy_key ); ?>"><?php echo esc_html( $legacy_name ); ?></option><?php endforeach; ?></select></div>
