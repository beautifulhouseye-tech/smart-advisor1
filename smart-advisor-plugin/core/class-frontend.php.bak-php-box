<?php
/**
 * Smart Advisor - Frontend
 *
 * Version: 2.1.0
 * 
 * @package SmartAdvisor
 */

if ( ! defined( 'ABSPATH' ) ) {
    exit;
}

class SA_Frontend {

    const MAX_HISTORY = 20;

    private static $rendered_wa_register = false;
    private static $rendered_wa_login = false;

    public static function init() {
        add_action( 'init', array( __CLASS__, 'register_account_endpoint' ), 5 );
        add_filter( 'query_vars', array( __CLASS__, 'register_account_query_var' ) );
        // Register the endpoint with WooCommerce as well as WordPress.
        add_filter( 'woocommerce_get_query_vars', array( __CLASS__, 'register_woocommerce_query_var' ) );
        // Flush rewrite rules once after an update, after the endpoint is registered.
        add_action( 'init', array( __CLASS__, 'maybe_flush_account_endpoint_rules' ), 99 );
        add_filter( 'woocommerce_account_menu_items', array( __CLASS__, 'add_account_menu_item' ) );
        add_action( 'woocommerce_account_smart-advisor-profile_endpoint', array( __CLASS__, 'render_customer_profile' ) );
        add_action( 'wp_enqueue_scripts', array( __CLASS__, 'enqueue_assets' ) );
        add_action( 'wp_footer', array( __CLASS__, 'render' ), 5 );
        add_action( 'wp_footer', array( __CLASS__, 'inject_wa_box_once' ), 99 );
        add_action( 'wp_head', array( __CLASS__, 'render_wa_box_styles' ) );
        add_shortcode( 'sa_wishlist', array( __CLASS__, 'render_wishlist_shortcode' ) );
        add_filter( 'the_content', array( __CLASS__, 'maybe_render_wishlist_page' ), 20 );
    }

    public static function enqueue_assets() {
        $version = defined( 'MBA_VERSION' ) ? MBA_VERSION : '5.4.1';
        $base    = defined( 'MBA_SANDBOX_URL' ) ? MBA_SANDBOX_URL : plugin_dir_url( dirname( __DIR__ ) . '/smart-advisor.php' );
        $on_profile = ( function_exists( 'is_wc_endpoint_url' ) && is_wc_endpoint_url( 'smart-advisor-profile' ) )
            || ( function_exists( 'is_account_page' ) && is_account_page() && get_query_var( 'smart-advisor-profile', false ) !== false );
        if ( $on_profile ) {
            wp_enqueue_script( 'sa-profile', $base . 'assets/js/profile.js', array(), $version, true );
        }
        if ( ! class_exists( 'SA_Settings' ) || ! SA_Settings::should_display() ) {
            return;
        }
        wp_enqueue_style( 'sa-chat', $base . 'assets/css/chat.css', array(), $version );
        wp_enqueue_script( 'sa-chat', $base . 'assets/js/chat.js', array(), $version, true );
        $color    = self::get_safe_color( SA_Settings::get( 'icon_color', '#e91e63' ) );
        $position = SA_Settings::get( 'position', 'bottom-right' );
        if ( ! in_array( $position, array( 'bottom-left', 'bottom-right' ), true ) ) {
            $position = 'bottom-right';
        }
        $cs = class_exists( 'SA_Customer_Service_Settings' ) ? SA_Customer_Service_Settings::get_config() : [];
        wp_localize_script(
            'sa-chat',
            'SA_CHAT_CONFIG',
            array(
                'endpoint' => self::get_safe_url( rest_url( 'smart-advisor/v1/chat' ) ),
                'projectsEndpoint' => is_user_logged_in() ? self::get_safe_url( rest_url( 'smart-advisor/v1/profile/projects' ) ) : '',
                'session'  => self::get_safe_url( rest_url( 'smart-advisor/v1/session' ) ),
                'nonce'    => wp_create_nonce( 'wp_rest' ),
                'position' => $position,
                'color'    => $color,
                'assistantName' => sanitize_text_field( $cs['assistant_name'] ?? 'مساعد المتجر' ),
                'welcomeMessage' => sanitize_text_field( $cs['welcome_message'] ?? '' ),
            )
        );
        wp_add_inline_style( 'sa-chat', ':root{--sa-color:' . esc_attr( $color ) . ';}' );
    }

    public static function register_account_endpoint() {
        add_rewrite_endpoint( 'smart-advisor-profile', EP_ROOT | EP_PAGES );
    }

    public static function register_account_query_var( $vars ) {
        if ( ! in_array( 'smart-advisor-profile', $vars, true ) ) {
            $vars[] = 'smart-advisor-profile';
        }
        return $vars;
    }

    /** Register the custom endpoint in WooCommerce's endpoint map. */
    public static function register_woocommerce_query_var( $vars ) {
        $vars['smart-advisor-profile'] = 'smart-advisor-profile';
        return $vars;
    }

    /** Flush rewrite rules once so existing installations pick up the endpoint. */
    public static function maybe_flush_account_endpoint_rules() {
        $rewrite_version = '1';
        if ( get_option( 'sa_smart_advisor_account_endpoint_rewrite_version' ) !== $rewrite_version ) {
            flush_rewrite_rules( false );
            update_option( 'sa_smart_advisor_account_endpoint_rewrite_version', $rewrite_version, false );
        }
    }

    public static function add_account_menu_item( $items ) {
        $logout = isset( $items['customer-logout'] ) ? $items['customer-logout'] : null;
        unset( $items['customer-logout'] );
        $items['smart-advisor-profile'] = 'مستشاري الشخصي';
        if ( null !== $logout ) $items['customer-logout'] = $logout;
        return $items;
    }

    public static function render_customer_profile() {
        if ( ! is_user_logged_in() ) {
            echo '<p dir="rtl">يرجى تسجيل الدخول لعرض ملفك الشخصي.</p>';
            return;
        }
        $project_types = [];
        if ( class_exists( 'SA_Project_Type_Settings' ) ) {
            foreach ( SA_Project_Type_Settings::all() as $type_key => $type_config ) {
                if ( empty( $type_config['enabled'] ) ) continue;
                $project_types[] = [
                    'key' => (string) $type_key,
                    'name' => sanitize_text_field( $type_config['name'] ?? $type_key ),
                    'questions' => array_values( (array) ( $type_config['questions'] ?? [] ) ),
                ];
            }
        }
        $config = [
            'root'  => esc_url_raw( rest_url( 'smart-advisor/v1/' ) ),
            'nonce' => wp_create_nonce( 'wp_rest' ),
            'projectTypes' => $project_types,
        ];
        ?>
